{
  "name": "@woksin/pi-orch",
  "version": "0.1.1",
  "description": "Lean repo-owner orchestration: durable order bus, batched candidate PRs, shared GitHub poller",
  "license": "MIT",
  "author": "woksin",
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=30000 'test/*.test.ts'",
    "check": "node test/check.ts",
    "prepack": "node scripts/build.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/extension/lane-bus.ts"
    ]
  },
  "bin": {
    "orch": "./bin/orch",
    "orch-poll": "./bin/orch-poll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woksin/pi-orch.git"
  },
  "homepage": "https://github.com/woksin/pi-orch#readme",
  "bugs": {
    "url": "https://github.com/woksin/pi-orch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "orchestration",
    "multi-agent"
  ],
  "files": [
    "src/",
    "dist/",
    "scripts/",
    "bin/",
    "docs/",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
